#!/usr/bin/env python3
"""Read-only battery source sampler for macOS and Linux."""

import argparse
import json
import platform
import re
import subprocess
import sys
import time
from pathlib import Path

VERSION = "0.1.0"


def parse_pmset(text):
    source_match = re.search(r"Now drawing from ['\"]?([^'\"\n]+)", text)
    percent_match = re.search(r"(\d{1,3})%;", text)
    state_match = re.search(r"%;\s*([^;\n]+)", text)
    return {
        "source": source_match.group(1).strip() if source_match else "unknown",
        "percent": int(percent_match.group(1)) if percent_match else None,
        "state": state_match.group(1).strip() if state_match else "no battery reported",
    }


def read_macos():
    try:
        result = subprocess.run(
            ["pmset", "-g", "batt"], capture_output=True, text=True, timeout=5, check=False
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise RuntimeError(f"pmset unavailable: {exc}") from exc
    if result.returncode != 0:
        raise RuntimeError("pmset could not read battery status")
    return parse_pmset(result.stdout)


def read_linux():
    root = Path("/sys/class/power_supply")
    batteries = []
    if root.is_dir():
        for item in sorted(root.iterdir()):
            try:
                if (item / "type").read_text().strip() != "Battery":
                    continue
                batteries.append(
                    {
                        "source": "Battery",
                        "percent": int((item / "capacity").read_text().strip()),
                        "state": (item / "status").read_text().strip().lower(),
                    }
                )
            except (OSError, ValueError):
                continue
    if not batteries:
        return {"source": "unknown", "percent": None, "state": "no battery reported"}
    return batteries[0]


def read_live():
    system = platform.system()
    if system == "Darwin":
        return read_macos()
    if system == "Linux":
        return read_linux()
    raise RuntimeError(f"unsupported operating system: {system}")


def load_fixture(path):
    chunks = Path(path).read_text().split("\n---\n")
    return [parse_pmset(chunk) for chunk in chunks if chunk.strip()]


def assess(samples):
    transitions = sum(
        1 for previous, current in zip(samples, samples[1:])
        if previous["source"] != current["source"]
    )
    percentages = [sample["percent"] for sample in samples if sample["percent"] is not None]
    low = bool(percentages and min(percentages) <= 10)
    if transitions:
        verdict = "power source changed during sampling; inspect the cable, dock, charger, and port"
    elif low:
        verdict = "battery is at or below 10%; a native low-battery warning is expected"
    elif not percentages:
        verdict = "no battery percentage was exposed on this machine"
    else:
        verdict = "no source transition or low-battery condition was observed"
    return {"samples": len(samples), "source_transitions": transitions, "low_battery": low, "verdict": verdict}


def text_report(samples, result):
    print("BatteryNag Audit — read-only power snapshot")
    for index, sample in enumerate(samples, 1):
        percent = "n/a" if sample["percent"] is None else f"{sample['percent']}%"
        print(f"Sample {index}: source={sample['source']} battery={percent} state={sample['state']}")
    print(f"Transitions: {result['source_transitions']}")
    print(f"Assessment: {result['verdict']}")
    print("Safety: no alerts, settings, files, or processes were changed.")
    print("Limit: a short sample cannot prove why a notification appeared.")


def main():
    parser = argparse.ArgumentParser(
        description="Sample battery/power state without dismissing alerts or changing settings."
    )
    parser.add_argument("--samples", type=int, default=1, help="number of live samples (1-60)")
    parser.add_argument("--interval", type=float, default=5, help="seconds between live samples (1-300)")
    parser.add_argument("--json", action="store_true", help="emit machine-readable output")
    parser.add_argument("--fixture", help=argparse.SUPPRESS)
    parser.add_argument("--version", action="version", version=f"BatteryNag Audit {VERSION}")
    args = parser.parse_args()
    if not 1 <= args.samples <= 60:
        parser.error("--samples must be between 1 and 60")
    if not 1 <= args.interval <= 300:
        parser.error("--interval must be between 1 and 300")
    try:
        if args.fixture:
            samples = load_fixture(args.fixture)
        else:
            samples = []
            for index in range(args.samples):
                samples.append(read_live())
                if index + 1 < args.samples:
                    time.sleep(args.interval)
    except (OSError, RuntimeError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    if not samples:
        print("error: no samples available", file=sys.stderr)
        return 2
    result = assess(samples)
    if args.json:
        print(json.dumps({"version": VERSION, "read_only": True, "observations": samples, "assessment": result}, indent=2))
    else:
        text_report(samples, result)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
